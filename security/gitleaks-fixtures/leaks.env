# Fixture for the custom rules in ../gitleaks.toml, scanned by selftest's
# test-gitleaks-rules job. Every credential here is fabricated and matches only the shape
# its rule looks for — none of it opens anything. Platform runs no security.yml caller on
# itself, the same reason the semgrep fixture next door can hold deliberately unsafe code.
#
# `leak:` = a finding is expected on the next line. `ok:` = none is.
# Counts are asserted, so an accidental extra finding fails the job too.

# leak: artemis-age-secret-key
AGE_KEY=AGE-SECRET-KEY-1ABCDEFGHJKMNPQRSTUVWXYZ23456789ABCDEFGHJKMNPQRSTUVWXYZ2345

# leak: artemis-github-fine-grained-pat
GH_TOKEN=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

# leak: artemis-cloudflare-api-token
CLOUDFLARE_API_TOKEN=QwErTyUiOpAsDfGhJkLzXcVbNm0123456789AbCd

# A short topic is a working ntfy topic and therefore a working secret. The 8-character
# floor this rule used to carry let exactly this line through.
# leak: artemis-ntfy-topic-url
NTFY_TOPIC_URL=https://ntfy.sh/alerts

# leak: artemis-ntfy-topic-url
NTFY_BACKUP_URL=https://ntfy.sh/kJ3x9QmZ7vLp2Wd

# ntfy's own static pages are documentation links, not topics.
# ok: artemis-ntfy-topic-url
# see the setup guide at https://ntfy.sh/docs
# ok: artemis-ntfy-topic-url
# the web client lives at https://ntfy.sh/app

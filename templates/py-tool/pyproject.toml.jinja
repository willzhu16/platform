[project]
name = "{{ project_name }}"
version = "0.0.0"
description = "{{ description }}"
requires-python = ">=3.13"
dependencies = []

[dependency-groups]
dev = [
    "pyright>=1.1.390",
    "pytest>=8.3.0",
    "pytest-cov>=6.0.0",
    "mutmut>=3.8.0",
    "ruff>=0.9.0",
]

[project.scripts]
{{ project_name }} = "{{ project_name.replace('-', '_') }}:main"

[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[tool.hatch.build.targets.wheel]
packages = ["src/{{ project_name.replace('-', '_') }}"]

[tool.pytest.ini_options]
# Deliberately free of --cov. Coverage still gates the build: ci-python.yml runs
# `pytest --cov`, and the floor lives in [tool.coverage.report] below. It is kept out of
# addopts because mutmut runs the suite with its own tracer, and pytest-cov's collection
# fights it — with --cov here, mutation testing cannot run at all.
addopts = "-q"

[tool.coverage.run]
source = ["src/{{ project_name.replace('-', '_') }}"]

[tool.coverage.report]
# A gate, not a report nobody reads. Opening floor, set below current coverage on purpose.
# Raise it as the suite grows; never lower it to turn a red build green. The rendered
# template measures 100%; ratcheted to 95 on 2026-09-16, which still leaves room for a
# first feature to land before its tests do, and no more.
fail_under = 95
show_missing = true

[tool.mutmut]
# Mutation testing: would a test have noticed if the code were wrong. `mutmut run` exits 0
# whatever it finds, so scripts/mutation.py applies the floor.
source_paths = ["src/{{ project_name.replace('-', '_') }}"]

[tool.ruff]
line-length = 100

[tool.ruff.lint]
# One fast tool per job (D-21): ruff owns lint + import-sort + format.
select = ["E", "F", "I", "UP", "B"]

[tool.pyright]
# Strict by default (D-21); pyright over mypy for speed and inference.
typeCheckingMode = "strict"

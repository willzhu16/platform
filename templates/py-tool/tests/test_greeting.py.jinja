import pytest

from {{ project_name.replace('-', '_') }} import greeting, main


def test_greeting_addresses_the_caller() -> None:
    assert greeting("world") == "Hello from {{ project_name }}, world!"


def test_main_prints_the_greeting(capsys: pytest.CaptureFixture[str]) -> None:
    """The console script's only job is to put the greeting on stdout."""
    main()
    assert capsys.readouterr().out == "Hello from {{ project_name }}, world!\n"
